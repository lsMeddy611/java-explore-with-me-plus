{
    "version": "2.0.0",
    "runtimeConfiguration": {
        "environment": "default",
        "laxTestingModeEnabled": false,
        "apiConnectivityCheck": true,
        "logLevel": "error",
        "logDestination": "stdout+platform",
        "logMaxFileSize": 2147483648,
        "requestHeaderNameRequestId": "x-scan-request-id",
        "requestHeaderNameScenarioId": "x-scan-scenario-id",
        "requestHeaderNameRequestType": "x-scan-request-type",
        "requestFlowrate": 100,
        "requestTimeout": 30,
        "requestTlsInsecureSkipVerify": true,
        "responseFollowRedirection": false,
        "responseMaxBodySizeScan": 10485760,
        "happyPathOnly": false,
        "maxRequestRetryAttempts": 5,
        "maxScanDuration": 1800,
        "memoryLimit": 2147483648,
        "memoryTimeSpan": 10,
        "reportMaxRequestSizeHappyPath": 8092,
        "reportMaxRequestSizeTest": 8092,
        "reportIncludeRequestBody": true,
        "reportIncludeResponseBody": true,
        "reportMaxHttpResponseSizeHappyPath": 8092,
        "reportMaxBodySizeHappyPath": 8092,
        "reportMaxHttpResponseSizeTest": 8092,
        "reportMaxBodySizeTest": 8092,
        "reportIssuesOnly": false,
        "reportMaxIssues": 1000,
        "reportMaxSize": 20971520,
        "reportGenerateCurlCommand": true,
        "normalizeServerUrls": true
    },
    "customizations": {
        "happyPaths": {
            "retry": 1,
            "responsePolicy": {
                "httpStatusExpected": true,
                "mustBeConformant": true
            },
            "httpStatusExpected": [
                "2XX",
                "404"
            ]
        },
        "tests": {
            "responsePolicy": {
                "httpStatusExpected": true,
                "mustBeConformant": true
            }
        },
        "requests": {}
    },
    "operations": {
        "getStats": {
            "operationId": "getStats",
            "scenarios": [
                {
                    "key": "happy.path",
                    "fuzzing": true,
                    "requests": [
                        {
                            "$ref": "#/operations/getStats/request",
                            "fuzzing": true
                        }
                    ]
                }
            ],
            "request": {
                "operationId": "getStats",
                "request": {
                    "type": "42c",
                    "details": {
                        "url": "{{host}}/stats",
                        "method": "GET",
                        "queries": [
                            {
                                "key": "start",
                                "value": "pfstrqfravhgqjgkjgyxjlrnmzawsswg"
                            },
                            {
                                "key": "end",
                                "value": "jprvpgloemigrbacdqzvucyfqgobvyyd"
                            },
                            {
                                "key": "uris",
                                "value": [
                                    "vtqdckzgfsgujahswmacvjpolxpodcge",
                                    "vtqdckzgfsgujahswmacvjpolxpodcge",
                                    "vtqdckzgfsgujahswmacvjpolxpodcge",
                                    "vtqdckzgfsgujahswmacvjpolxpodcge",
                                    "vtqdckzgfsgujahswmacvjpolxpodcge"
                                ]
                            },
                            {
                                "key": "unique",
                                "value": false
                            }
                        ]
                    }
                },
                "defaultResponse": "200",
                "responses": {
                    "200": {
                        "expectations": {
                            "httpStatus": 200
                        }
                    }
                }
            }
        },
        "hit": {
            "operationId": "hit",
            "scenarios": [
                {
                    "key": "happy.path",
                    "fuzzing": true,
                    "requests": [
                        {
                            "$ref": "#/operations/hit/request",
                            "fuzzing": true
                        }
                    ]
                }
            ],
            "request": {
                "operationId": "hit",
                "request": {
                    "type": "42c",
                    "details": {
                        "url": "{{host}}/hit",
                        "method": "POST",
                        "headers": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "requestBody": {
                            "mode": "json",
                            "json": {
                                "app": "ewm-main-service",
                                "ip": "192.163.0.1",
                                "timestamp": "2022-09-06 11:00:23",
                                "uri": "/events/1"
                            }
                        }
                    }
                },
                "defaultResponse": "201",
                "responses": {
                    "201": {
                        "expectations": {
                            "httpStatus": 201
                        }
                    }
                }
            }
        }
    },
    "environments": {
        "default": {
            "variables": {
                "host": {
                    "from": "environment",
                    "name": "SCAN42C_HOST",
                    "required": false,
                    "default": "http://localhost:9090"
                }
            }
        }
    }
}